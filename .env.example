PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# long random string, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# frontend origin(s) allowed to call the API, comma separated
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# optional, for calls on networks that block a direct connection. Comma separated, e.g. turn:host:3478,turns:host:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
