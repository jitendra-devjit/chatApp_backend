PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# long random string, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# frontend origin(s) allowed to call the API, comma separated
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Calls between phones on mobile data need a TURN server that relays them. Without one only
# calls on networks that allow a direct connection work. Use one of the two:
# 1. Cloudflare Realtime TURN (dashboard -> Realtime -> TURN Server -> Create)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# 2. any TURN server with a fixed login. Comma separated, e.g. turn:host:3478,turns:host:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Limits that keep the relay inside its free monthly allowance (these are the defaults):
# a call ends after this many minutes, and after this many hours of calls in a month no relay is handed out
CALL_MAX_MINUTES=60
CALL_MONTHLY_HOURS=150
